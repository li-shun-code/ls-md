{
  "name": "markdown-desk",
  "version": "0.2.1",
  "description": "墨笺：面向 Windows 与 macOS 的现代化 AI Markdown 编辑器。",
  "main": "./out/main/index.js",
  "author": "墨笺",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:all": "npm run build && electron-builder -mw --publish never"
  },
  "dependencies": {
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-code-block-lowlight": "3.30.5",
    "@tiptap/extension-highlight": "3.30.5",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-mathematics": "3.30.5",
    "@tiptap/extension-placeholder": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/extension-table-cell": "3.30.5",
    "@tiptap/extension-table-header": "3.30.5",
    "@tiptap/extension-table-row": "3.30.5",
    "@tiptap/extension-task-item": "3.30.5",
    "@tiptap/extension-task-list": "3.30.5",
    "@tiptap/extension-typography": "3.30.5",
    "@tiptap/markdown": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "highlight.js": "11.12.0",
    "katex": "0.18.4",
    "lowlight": "3.3.0",
    "lucide-react": "^0.468.0",
    "mermaid": "11.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.markdowndesk.app",
    "productName": "墨笺",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkdn",
          "mkd"
        ],
        "name": "Markdown document",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  }
}
